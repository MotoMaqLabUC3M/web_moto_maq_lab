# API — copia a .env
APP_ENV=development
HTTP_ADDR=:8080

DB_DRIVER=sqlite
DATABASE_URL=file:./data/motomaqlab.db?_pragma=foreign_keys(1)

# DB_DRIVER=postgres
# DATABASE_URL=postgres://motomaqlab:secret@localhost:5432/motomaqlab?sslmode=disable

JWT_SECRET=genera-un-secreto-largo-y-aleatorio
JWT_EXPIRY_HOURS=72
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password-seguro

UPLOAD_DIR=./data/uploads
PUBLIC_API_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
MAX_UPLOAD_MB=10
