# =============================================================================
# MotoMaqLab Platform — Docker (deploy/)
# cp .env.example .env
# =============================================================================

# --- PostgreSQL (solo producción: docker-compose.yml) ---
POSTGRES_DB=motomaqlab
POSTGRES_USER=motomaqlab
POSTGRES_PASSWORD=cambiar-password-postgres

# --- API ---
API_PORT=8080
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-min-32-chars
JWT_EXPIRY_HOURS=72
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-password-admin-seguro
MAX_UPLOAD_MB=10

# URL pública de la API (para URLs de imágenes en /media/*)
PUBLIC_API_BASE_URL=https://motomaqlabuc3m.es

# Orígenes permitidos (mismo dominio en VPS), separados por coma
CORS_ORIGINS=http://localhost:3000,https://motomaqlabuc3m.es

# --- Admin (Next.js en /admin) ---
# En VPS: misma URL que el sitio (nginx hace proxy de /api)
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Nginx (producción) ---
HTTP_PORT=80

# Producción VPS — un solo dominio:
# NEXT_PUBLIC_API_URL=https://motomaqlabuc3m.es
# PUBLIC_API_BASE_URL=https://motomaqlabuc3m.es
# CORS_ORIGINS=https://motomaqlabuc3m.es
# Panel: https://motomaqlabuc3m.es/admin/
