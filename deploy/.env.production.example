# =============================================================================
# MotoMaqLab — PRODUCCIÓN (Coolify / docker-compose.yml)
# =============================================================================
#
# NO subas secretos al repositorio.
#
# Coolify:
#   Base directory: /
#   Compose file:   /docker-compose.yml
#   Branch:         feat/implement-backend (o main tras merge)
#
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=motomaqlab
POSTGRES_USER=motomaqlab
POSTGRES_PASSWORD=__CAMBIAR_POSTGRES_PASSWORD__

# --- API (Go) ---
JWT_SECRET=__CAMBIAR_JWT_SECRET_MIN_32_CHARS__
JWT_EXPIRY_HOURS=72
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__CAMBIAR_ADMIN_PASSWORD__
MAX_UPLOAD_MB=10

# local = volumen uploads_data en el VPS
# r2    = Cloudflare R2 (recomendado en producción)
STORAGE_DRIVER=local

# --- URLs públicas (mismo dominio; nginx hace proxy) ---
PUBLIC_API_BASE_URL=https://motomaqlab.pablomontesfm.com
NEXT_PUBLIC_API_URL=https://motomaqlab.pablomontesfm.com
NEXT_PUBLIC_SITE_URL=https://motomaqlab.pablomontesfm.com
CORS_ORIGINS=https://motomaqlab.pablomontesfm.com

# --- Cloudflare R2 (solo si STORAGE_DRIVER=r2) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=motomaqlab-media
# R2_PUBLIC_URL=https://media.motomaqlabuc3m.es
# NEXT_PUBLIC_MEDIA_URL=https://media.motomaqlabuc3m.es

# --- Nginx ---
HTTP_PORT=80
